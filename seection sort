#include<stdio.h>

void main()
{
    int i,j,min,n,arr[20],temp;

    printf("Enter the number of Elements: ");
    scanf("%d", &n);

    printf("\nEnter the %d Elements to Sort: \n",n);

    for(i=0;i<n;i++)
    {
        scanf("%d", &arr[i]);
    }

    for(i=0;i<=n-2;i++)
    {
        min = i;
        for(j=i+1;j<=n-1;j++)
        {
            if(arr[j] < arr[min])
            {
                min = j;
            }
        }

        if(min != i)
        {
            temp = arr[i];
            arr[i] = arr[min];
            arr[min] = temp;
        }
    }

    printf("\nThe Sorted ELements using Selection Sort:");

    for(i=0;i<n;i++)
    {
        printf("%d  ",arr[i]);
    }
}


#include <stdio.h>

#define INF 99999
#define MAX 20

int main()
{
    int d[MAX][MAX], n, i, j, k;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter cost matrix (use %d for no edge):\n", INF);
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &d[i][j]);

    for (k = 0; k < n; k++)
        for (i = 0; i < n; i++)
            for (j = 0; j < n; j++)
                if (d[i][k] != INF && d[k][j] != INF)
                    if (d[i][k] + d[k][j] < d[i][j])
                        d[i][j] = d[i][k] + d[k][j];

    printf("\nAll pair shortest path matrix:\n\n");
    printf("From\\To");
    for (j = 0; j < n; j++)
        printf("%6d", j + 1);
    printf("\n");

    for (i = 0; i < n; i++)
    {
        printf("%7d", i + 1);
        for (j = 0; j < n; j++)
        {
            if (d[i][j] == INF)
                printf("%6s", "INF");
            else
                printf("%6d", d[i][j]);
        }
        printf("\n");
    }

    return 0;
}


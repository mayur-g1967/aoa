#include<stdio.h>

void main()
{
    int i,n,arr[20], key,j;
    printf("Enter the Number of array elements (Max 15): ");
    scanf("%d", &n);

    printf("\nEnter the %d Array elements to Sort: \n", n);
    
    for(i=0;i<n;i++)
        scanf("%d", &arr[i]);
    
    for(i=1;i<n;i++)
    {
        key = arr[i];
        j = i-1;

        while(j>=0 && arr[j]>key)
        {
            arr[j+1] = arr[j];
            j = j-1;
        }
        
        arr[j+1] = key;
    }

    printf("\nThe Elements sorted using the Insertion Sort are: ");

    for(i=0;i<n;i++)
        printf("%d  ", arr[i]);
    
}


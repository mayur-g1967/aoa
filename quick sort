#include <stdio.h>

void swap(int *x, int *y)
{
    int t;
    t = *x;
    *x = *y;
    *y = t;
}

int partition(int a[], int lb, int ub)
{
    int pivot, start, end;
    pivot = a[lb];
    start = lb;
    end = ub;

    while (start < end)
    {
        while (start < ub && a[start] <= pivot)
            start++;
        while (a[end] > pivot)
            end--;
        if (start < end)
            swap(&a[start], &a[end]);
    }
    swap(&a[lb], &a[end]);
    return end;
}

void quickSort(int a[], int lb, int ub)
{
    int loc;
    if (lb < ub)
    {
        loc = partition(a, lb, ub);
        quickSort(a, lb, loc - 1);
        quickSort(a, loc + 1, ub);
    }
}

int main()
{
    int a[100], n, i;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements: ", n);
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    quickSort(a, 0, n - 1);

    printf("Sorted array: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);
    printf("\n");

    return 0;
}

/*
Algorithm Partition(A, lb, ub)
Step 1: pivot = A[lb]
Step 2: start = lb
Step 3: end = ub
Step 4: Repeat while start < end
Step 5:     Repeat while A[start] <= pivot : start = start + 1
Step 6:     Repeat while A[end] > pivot : end = end - 1
Step 7:     If start < end then swap A[start] and A[end]
Step 8: Swap A[lb] and A[end]
Step 9: Return end

Algorithm QuickSort(A, lb, ub)
Step 1: If lb < ub then
Step 2:     loc = Partition(A, lb, ub)
Step 3:     QuickSort(A, lb, loc - 1)
Step 4:     QuickSort(A, loc + 1, ub)
Step 5: End
*/

#include <stdio.h>
#include <string.h>

int main()
{
    char text[100], pattern[100];
    int n, m, i, j, found = 0;

    printf("Enter the text: ");
    scanf("%99s", text);
    printf("Enter the pattern: ");
    scanf("%99s", pattern);

    n = strlen(text);
    m = strlen(pattern);

    for (i = 0; i <= n - m; i++)
    {
        j = 0;
        while (j < m && text[i + j] == pattern[j])
            j = j + 1;
        if (j == m)
        {
            printf("Pattern found at position %d\n", i);
            found = 1;
        }
    }

    if (!found)
        printf("Pattern not found\n");
    return 0;
}

